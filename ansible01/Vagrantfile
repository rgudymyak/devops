Vagrant.configure("2") do |config|
  config.vm.box = "generic/cenots8"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = "1024"
    vb.cpus = 2
  end

  config.vm.define "centosv1" do |centosv1|
    centosv1.vm.hostname = "centosv1"
  end

  config.vm.define "centosv2" do |centosv2|
    centosv2.vm.hostname = "centosv2"
  end
end 
